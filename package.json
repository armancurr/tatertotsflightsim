{
  "name": "tatertotsflightsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tater's Flight Sim (Tater Tots Flight Simulator): a browser 3D flight simulator — fly a Cessna 172RG or an F-16C over a procedural world with real flight physics. Three.js + TypeScript, no downloaded assets.",
  "keywords": [
    "flight-simulator",
    "flight-sim",
    "threejs",
    "webgl2",
    "typescript",
    "vite",
    "browser-game",
    "procedural-generation",
    "cessna",
    "f-16"
  ],
  "license": "MIT",
  "author": "Jared Tate",
  "homepage": "https://github.com/<owner>/tatertotsflightsim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<owner>/tatertotsflightsim.git"
  },
  "bugs": {
    "url": "https://github.com/<owner>/tatertotsflightsim/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8092 --strictPort",
    "dev": "vite --host 127.0.0.1 --port 8092 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8092 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "shot": "node scripts/shot.mjs",
    "repo-map": "node scripts/repo-map.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
