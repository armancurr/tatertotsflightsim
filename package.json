{
  "name": "flight-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based 3D flight simulator: a Cessna 172RG over a large procedural world, built with Three.js",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8092 --strictPort",
    "dev": "vite --host 127.0.0.1 --port 8092 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8092 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
